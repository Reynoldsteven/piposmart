# Server
PORT=8080
GIN_MODE=debug

# MySQL — format: user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=True&loc=Local
DB_DSN=root:password@tcp(127.0.0.1:3306)/piposmart?charset=utf8mb4&parseTime=True&loc=Local

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_HOURS=24

# CORS — use * for dev, restrict in production (e.g. http://localhost:3000)
CORS_ORIGIN=*
